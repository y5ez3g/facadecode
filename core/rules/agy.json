{
	"cli": "agy",
	"display_name": "Antigravity",
	"program": "agy",
	"arguments": {"reserved": ["--dangerously-skip-permissions", "--mode", "--sandbox", "--conversation", "--continue", "-c", "--remote-agent", "--print", "-p", "--prompt", "--prompt-interactive", "-i", "--model", "--effort"], "single_dash": true, "required": ["--add-dir", "--agent", "--conversation", "--effort", "--input-format", "--json-schema", "--log-file", "--mode", "--model", "--output-format", "--print-timeout", "--project", "--settings"]},
	"choices": {"model": ["--model", "${value}"], "effort": ["--effort", "${value}"], "spelling": {"model": ["--model"], "effort": ["--effort"]}},
	"input": {
		"mechanism": "frame",
		"prompt": ">",
		"gap": " ",
		"upper": "^─+$",
		"lower": "^─+$",
		"scrolled": { "above": "^↑ (\\d+) more lines?$", "below": "^↓ (\\d+) more lines?$" },
		"placeholder": {
			"texts": ["Accept-edits mode: file edits auto-approved (shift+tab to cycle)", "Plan mode: research & plan only (shift+tab to cycle)"],
			"footer": "^\\? for shortcuts(?:\\s|$)"
		},
		"menus": [{ "selected": "^ ?> \\S", "not_selected": "^ ?> /", "next": "^ {2,3}\\S", "hint": { "pattern": "^ {2,3}↑/↓ Navigate · ", "within": 8 } }]
	},
	"paste": { "enter_ms": 80, "line_ms": 45, "placeholders": [{ "pattern": "^\\[Pastedtext#\\d+\\+(\\d+)lines?\\]$", "count": "lines" }] },
	"session": { "capture": "session_start", "resume": ["--conversation", "${session_id}"] },
	"mcp": { "session_meta_key": "antigravity.google/root_conversation_id", "always_load_key": "antigravity/alwaysLoad" },
	"ready_tools": { "text": "/mcp", "typed": "^> /mcp\\s*$", "ready": "✓\\s+facade_facade\\b", "opened": "^MCP Servers\\s*$|\\besc Exit\\b", "close": "Escape" },
	"yolo": {
		"args": ["--mode", "accept-edits", "--dangerously-skip-permissions"],
		"settings": { "trustedWorkspaces": ["${folder}"], "enableTerminalSandbox": false }
	}
}
