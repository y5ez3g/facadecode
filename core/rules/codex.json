{
	"cli": "codex",
	"display_name": "Codex",
	"program": "codex",
	"launch": { "args": ["--no-daemon"] },
	"arguments": {"reserved": ["--dangerously-bypass-approvals-and-sandbox", "--yolo", "--sandbox", "-s", "--ask-for-approval", "-a", "--approve-for-me", "--not-so-yolo", "--cd", "-C", "--worktree", "--remote", "--remote-auth-token-env", "--no-daemon", "--model", "-m", "--last"], "attached": ["-s", "-a", "-C", "-m"], "variadic": ["--image", "-i"], "clusters": ["-C", "-a", "-c", "-i", "-m", "-p", "-s"], "config": {"options": ["-c", "--config"], "reserved": ["check_for_update_on_startup", "projects", "mcp_servers.facade", "mcp_optional_startup_grace_ms", "approval_policy", "sandbox_mode", "model", "model_reasoning_effort"]}},
	"choices": {"model": ["--model", "${value}"], "effort": ["-c", "model_reasoning_effort=${value_toml}"], "spelling": {"model": ["--model", "-m"], "config": {"model": "model", "effort": "model_reasoning_effort"}}},
	"input": {
		"mechanism": "prompt",
		"prompt": "›",
		"alternate_prompt": "»",
		"model_line": "^ {2}\\S.*? · (?:[~/]|[A-Za-z]:\\\\)",
		"scroll_marks": { "above": "↑", "below": "↓" },
		"menus": [{ "selected": "^› \\d+\\. \\S", "next": "^ {2}\\d+\\. \\S", "hint": { "pattern": "^ {2}(?:Press )?[Ee]nter\\b", "within": 10 } }]
	},
	"paste": {
		"enter_ms": 80,
		"placeholders": [
			{ "pattern": "^\\[PastedContent(\\d+)chars?\\]$", "count": "chars" },
			{ "pattern": "^\\[PastedContent(\\d+)chars?\\]$", "count": "chars", "after_first_character": true }
		]
	},
	"session": { "capture": "session_start", "resume": ["resume", "${session_id}"] },
	"mcp": { "session_meta_key": "sessionId" },
	"status": {
		"mechanism": "background_correction",
		"hints": "^(?: {2}(?:← for agents · )?\\? for shortcuts(?: {2,}\\S.*)?| {20,}\\S.*)$",
		"background": "^ {2}([1-9]\\d*) background terminals? running",
		"footer": "  ${count} background terminal${s} running · /ps to view · /stop to close",
		"worked": "^ {2}Worked for (?:<1s|(?:\\d+[hms] ?)+) • \\d{1,2}:\\d{2}(?: [AP]M)?$"
	},
	"yolo": { "args": ["--dangerously-bypass-approvals-and-sandbox", "-c", "projects={ ${folder_toml} = { trust_level = \"trusted\" } }"] },
	"console": { "per_char_ms": 3, "records_above_bmp": true }
}
