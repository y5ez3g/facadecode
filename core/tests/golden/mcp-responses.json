  },
  "read_screen of an agent that does not exist": {
    "call": {
      "tool": "read_screen",
      "arguments": {
        "agent": "#a9"
      }
    },
    "response": {
      "status": "failure",
      "reason": "not_found",
      "message": "no agent #a9; nothing was done; you can reach #a1 ada, #a2 bob, #a3 helper"
    }
  },
  "stop_agent": {
    "call": {
      "tool": "stop_agent",
      "arguments": {
        "agent": "@helper"
      }
    },
    "response": {
      "status": "success"
    }
  },
  "stop_agent of an agent that does not exist": {
    "call": {
      "tool": "stop_agent",
      "arguments": {
        "agent": "#a9"
      }
    },
    "response": {
      "status": "failure",
      "reason": "not_found",
      "message": "no agent #a9; nothing was done; you can reach #a1 ada, #a2 bob, #a3 helper"
    }
  },
  "start_agent with a prompt": {
    "call": {
      "tool": "start_agent",
      "arguments": {
        "name": "twin",
        "cli": "fake",
        "window": "terminal",
        "path": "<test>/project",
        "prompt": "Read the README and summarize it."
      }
    },
    "response": {
      "status": "success",
      "data": {
        "id": "#a4",
        "name": "twin",
        "path": "<test>/project",
        "address": "#a4@golden-host",
        "machine_id": "<machine ID>",
        "windows": [
          {
            "machine_id": "<machine ID>",
            "window_id": "terminal"
          }
        ],
        "result_message_id": "m4",
        "result_message_machine_id": "<machine ID>"
      }
    }
  }
}
