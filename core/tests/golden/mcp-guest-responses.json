{
  "initialize by claude's guest server": {
    "call": {
      "method": "initialize",
      "server": [
        "--guest",
        "claude"
      ],
      "environment": {
        "CLAUDE_CODE_SESSION_ID": "claude-golden"
      }
    },
    "response": {
      "jsonrpc": "2.0",
      "id": 1,
      "result": {
        "protocolVersion": "2025-06-18",
        "capabilities": {
          "tools": {
            "listChanged": false
          }
        },
        "serverInfo": {
          "name": "facade",
          "version": "<version>"
        },
        "instructions": "The Orchestrator's MCP tools start, list and stop agents, exchange messages, and read or operate managed agents' terminals. Use an address such as a3@devbox, an agent number such as a3, or a name. Without a machine, a number or name resolves only on machines that are awake and reachable. Messages to a Guest are delivered when it takes them with read_messages within 30 seconds. After sending as a Guest, use the returned data.next call to wait for the reply. Messages to a managed agent are typed into its terminal. A 🔔 message reports an Orchestrator result."
      }
    }
  },
  "list_agents by claude's guest": {
    "call": {
      "tool": "list_agents",
      "arguments": {}
    },
    "response": {
      "status": "success",
      "data": {
        "agents": [
          {
            "id": "a2@golden-host",
            "name": "<guest name>",
            "type": "guest",
            "state": "online",
            "cli": "test",
            "folder": "<test>/home",
            "started_at": "<time>"
          },
          {
            "id": "a1@golden-host",
            "name": "host",
            "type": "managed",
            "state": "starting",
            "cli": "fake",
            "folder": "<test>/project",
            "started_at": "<time>"
          }
        ],
        "machines": [
          {
            "machine_id": "<machine ID>",
            "short_id": "<short machine ID>",
            "name": "golden-host",
            "selector": "golden-host",
            "build": "<version>",
            "state": "online",
            "status": "answered"
          }
        ]
      }
    }
  },
