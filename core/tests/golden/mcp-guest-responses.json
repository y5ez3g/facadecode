  "read_messages waiting as a guest": {
    "call": {
      "tool": "read_messages",
      "arguments": {
        "wait": true
      },
      "_meta": {
        "sessionId": "codex-golden"
      }
    },
    "response": {
      "status": "success",
      "data": {
        "messages": [
          {
            "id": "m1",
            "from": "a1@golden-host",
            "at": "<time>",
            "text": "hello guest"
          }
        ]
      }
    }
  },
  "send_message to a guest": {
    "call": {
      "tool": "send_message",
      "arguments": {
        "to": "a2@golden-host",
        "text": "hello guest"
      }
    },
    "response": {
      "status": "success",
      "data": {
        "id": "m1@golden-host",
        "delivery": "read_by_recipient"
      }
    }
  },
  "send_message from a guest": {
    "call": {
      "tool": "send_message",
      "arguments": {
        "to": "a1@golden-host",
        "text": "hello host",
        "reply_to": "m1"
      },
      "_meta": {
        "sessionId": "codex-golden"
      }
    },
    "response": {
      "status": "success",
      "data": {
        "id": "m2@golden-host",
        "delivery": "typed_into_input",
        "next": {
          "tool": "read_messages",
          "arguments": {
            "wait": true,
            "reply_to": "m2@golden-host"
          }
        }
      }
    }
  },
