{
  "name": "facade-agents",
  "publisher": "vscode",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "10.0.0",
  "license": "MIT",
  "engines": {
    "vscode": "^1.5.0"
  },
  "categories": [
    "Other"
  ],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension",
  "scripts": {
    "compile": "gulp compile-extension:facade-agents",
    "watch": "gulp watch-extension:facade-agents",
    "test": "node ../../node_modules/mocha/bin/mocha --ui tdd --timeout 30000 \"out/test/**/*.test.js\""
  },
  "contributes": {
    "commands": [
      {
        "command": "facade.agents.newAgent",
        "title": "%command.newAgent%",
        "category": "%command.category%",
        "icon": "$(add)",
        "enablement": "config.facade.orchestration.enabled"
      },
      {
        "command": "facade.agents.stopAgent",
        "title": "%command.stopAgent%",
        "category": "%command.category%",
        "icon": "$(debug-stop)",
        "enablement": "config.facade.orchestration.enabled"
      },
      {
        "command": "facade.agents.showTerminal",
        "title": "%command.showTerminal%",
        "category": "%command.category%",
        "icon": "$(terminal)",
        "enablement": "config.facade.orchestration.enabled"
      },
      {
        "command": "facade.agents.messageParticipant",
        "title": "%command.messageParticipant%",
        "category": "%command.category%",
        "icon": "$(comment)",
        "enablement": "config.facade.orchestration.enabled"
      },
      {
        "command": "facade.agents.reply",
        "title": "%command.reply%",
        "category": "%command.category%",
        "icon": "$(reply)",
        "enablement": "config.facade.orchestration.enabled"
      },
      {
        "command": "facade.agents.markAllRead",
        "title": "%command.markAllRead%",
        "category": "%command.category%",
        "icon": "$(check-all)",
        "enablement": "config.facade.orchestration.enabled"
      },
      {
        "command": "facade.agents.newPage",
        "title": "%command.newPage%",
        "category": "%command.category%",
        "icon": "$(new-file)",
        "enablement": "config.facade.orchestration.enabled"
      },
      {
        "command": "facade.agents.showLog",
        "title": "%command.showLog%",
        "category": "%command.category%"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "facade",
          "title": "%view.container%",
          "icon": "$(organization)"
        }
      ]
    },
    "views": {
      "facade": [
        {
          "id": "facade.needsYou",
          "name": "%view.needsYou%",
          "when": "config.facade.orchestration.enabled"
        },
        {
          "id": "facade.participants",
          "name": "%view.participants%",
          "when": "config.facade.orchestration.enabled"
        },
        {
          "id": "facade.messages",
          "type": "webview",
          "name": "%view.messages%",
          "when": "config.facade.orchestration.enabled"
        },
        {
          "id": "facade.notebook",
          "name": "%view.notebook%",
          "when": "config.facade.orchestration.enabled"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "facade.needsYou",
        "contents": "%view.needsYou.empty%"
      },
      {
        "view": "facade.notebook",
        "contents": "%view.notebook.empty%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "facade.agents.newAgent",
          "when": "view == facade.participants",
          "group": "navigation"
        },
        {
          "command": "facade.agents.markAllRead",
          "when": "view == facade.needsYou",
          "group": "navigation"
        },
        {
          "command": "facade.agents.newPage",
          "when": "view == facade.notebook",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "facade.agents.showTerminal",
          "when": "view == facade.participants && viewItem == agent",
          "group": "inline@1"
        },
        {
          "command": "facade.agents.messageParticipant",
          "when": "view == facade.participants && viewItem != person",
          "group": "inline@2"
        },
        {
          "command": "facade.agents.stopAgent",
          "when": "view == facade.participants && viewItem == agent",
          "group": "navigation@1"
        },
        {
          "command": "facade.agents.reply",
          "when": "view == facade.needsYou && viewItem == message",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "facade.agents.reply",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "facade.orchestration.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "%config.enabled%"
        },
        "facade.orchestration.maxParallel": {
          "type": "integer",
          "default": 4,
          "minimum": 1,
          "maximum": 12,
          "scope": "application",
          "description": "%config.maxParallel%"
        },
        "facade.orchestration.checkSlots": {
          "type": "integer",
          "default": 2,
          "minimum": 1,
          "maximum": 8,
          "scope": "application",
          "description": "%config.checkSlots%"
        },
        "facade.orchestration.ladder": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "application",
          "markdownDescription": "%config.ladder%"
        },
        "facade.orchestration.retriesPerRung": {
          "type": "integer",
          "default": 2,
          "minimum": 0,
          "maximum": 5,
          "scope": "application",
          "description": "%config.retriesPerRung%"
        },
        "facade.orchestration.agentConcurrency": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          },
          "default": {},
          "scope": "application",
          "markdownDescription": "%config.agentConcurrency%"
        },
        "facade.orchestration.hotspots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "package.json",
            "**/package-lock.json",
            "**/npm-shrinkwrap.json",
            "**/yarn.lock",
            "**/pnpm-lock.yaml",
            "**/Cargo.lock",
            "**/go.sum",
            "**/poetry.lock",
            "**/Gemfile.lock",
            "**/composer.lock"
          ],
          "scope": "resource",
          "markdownDescription": "%config.hotspots%"
        },
        "facade.orchestration.stallMinutes": {
          "type": "integer",
          "default": 20,
          "minimum": 5,
          "scope": "application",
          "description": "%config.stallMinutes%"
        },
        "facade.orchestration.closeVerifiedWorkers": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "%config.closeVerifiedWorkers%"
        },
        "facade.orchestration.workerMode": {
          "type": "string",
          "enum": [
            "interactive",
            "headless"
          ],
          "enumDescriptions": [
            "%config.workerMode.interactive%",
            "%config.workerMode.headless%"
          ],
          "default": "interactive",
          "scope": "application",
          "description": "%config.workerMode%"
        }
      }
    }
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/vscode.git"
  }
}
