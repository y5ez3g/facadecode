{
	"cli": "opencode",
	"display_name": "OpenCode",
	"program": "opencode",
	"launch": { "args": ["--standalone"], "agent_env": { "OPENCODE_DISABLE_AUTOUPDATE": "1" } },
	"arguments": {"reserved": ["--auto", "--yolo", "--dangerously-skip-permissions", "--session", "-s", "--continue", "-c", "--fork", "--standalone", "--server", "--prompt"], "attached": ["-s"], "clusters": ["-s"]},
	"input": {
		"mechanism": "box",
		"bar": "┃",
		"corner": "╹",
		"edge": "▀",
		"narrow_below": 44,
		"placeholder": "^(?:Ask anything|Run a command)… \"",
		"menus": [{ "selected": "^ *┃ {2}△ Permission required *$" }, { "selected": "^ +\\S.*? {2,}esc *$" }]
	},
	"paste": {
		"bracketed": true,
		"backspace_unit": "grapheme",
		"enter_ms": 80,
		"submit_clear_ms": 316,
		"retry_submit_ms": 316,
		"check_paste_end_on_windows": true,
		"placeholders": [{ "pattern": "^\\[Pasted~(\\d+)lines?\\]$", "count": "trimmed_lines" }]
	},
	"session": { "capture": "session_start", "resume": ["--session", "${session_id}"] },
	"mcp": { "session_meta_key": "ai.opencode/sessionID" },
	"status": {
		"mechanism": "turn_error",
		"error": "^ {5}Error: (.+)$",
		"summary": "^ {5}\\S.*? · .+ · (?:\\d+ms|\\d+\\.\\ds|\\d+m \\d+s|\\d+h \\d+m|\\d+d \\d+h)$"
	},
	"yolo": { "work": { "args": ["--auto"] } }
}
