{
	"cli": "pi",
	"display_name": "Pi",
	"program": "pi",
	"arguments": {"reserved": ["--session", "--session-id", "--continue", "-c", "--resume", "-r", "--fork", "--no-session", "--approve", "-a", "--no-approve", "-na", "--print", "-p", "--mode", "--export", "--model", "--provider", "--thinking", "--no-mcp", "--no-tools", "-nt"], "required": ["--provider", "--model", "--api-key", "--system-prompt", "--append-system-prompt", "--name", "-n", "--session", "--session-id", "--fork", "--session-dir", "--models", "--tools", "-t", "--exclude-tools", "-xt", "--thinking", "--export", "--extension", "-e", "--skill", "--prompt-template", "--theme"], "equals_value": false},
	"choices": {"model": ["--model", "${value}"], "effort": ["--thinking", "${value}"], "spelling": {"model": ["--model"], "effort": ["--thinking"]}},
	"input": {
		"mechanism": "editor",
		"upper": "^(?:─+|─{2,} \\S.*? ─+)$",
		"lower": "^─+(?: ↓ \\d+ more ─+)?$",
		"scrolled": { "position": "rules", "above": "^─{2,} ↑ (\\d+) more ─+$", "below": "^─+ ↓ (\\d+) more ─+$" },
		"most_rows": 5,
		"most_share": 0.3,
		"menus": [{ "selected": "^ ?→ \\S", "next": "^ {2,4}\\S", "hint": { "pattern": "[Ee]scape/[Cc]trl\\+[Cc]", "within": 40 } }]
	},
	"paste": {
		"enter_ms": 80,
		"placeholders": [
			{ "pattern": "^\\[paste#\\d+\\+(\\d+)lines?\\]$", "count": "lines" },
			{ "pattern": "^\\[paste #\\d+ (\\d+) chars?\\]$", "count": "visible_utf16", "spaced": true }
		]
	},
	"session": { "capture": "session_start", "resume": ["--session", "${session_id}"] },
	"mcp": { "managed_instructions_from_hook": true },
	"yolo": { "startup": { "args": ["--approve"], "env": { "PI_SKIP_VERSION_CHECK": "1" } } }
}
