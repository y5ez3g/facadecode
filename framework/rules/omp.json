{
	"cli": "omp",
	"display_name": "Oh My Pi",
	"program": "omp",
	"arguments": {
		"reserved": ["--session", "--continue", "-c", "--resume", "-r", "--restore", "--fork", "--from-claude", "--from-codex", "--no-session", "--approval-mode", "--auto-approve", "--yolo", "--plan-yolo", "--print", "-p", "--mode", "--export", "--model", "--provider", "--thinking", "--no-mcp", "--no-tools", "--tools", "-t", "--no-extensions", "--no-skills", "--no-ui", "--no-pty", "--cwd"],
		"required": ["--profile", "--session-dir", "--fork", "--mode", "--export", "--model", "--provider", "--thinking", "--approval-mode", "--config", "--plugin-dir", "--extension", "-e", "--hook", "--trusted-extension", "--api-key", "--system-prompt", "--system-prompt-template", "--append-system-prompt", "--provider-session-id", "--prompt-cache-key", "--tools", "-t", "--models", "--skills", "--theme", "--cwd", "--add-dir"]
	},
	"choices": {
		"model": ["--model", "${value}"], "effort": ["--thinking", "${value}"],
		"spelling": { "model": ["--model"], "effort": ["--thinking"] }
	},
	"input": {
		"mechanism": "editor",
		"hardware_cursor": true,
		"band": { "top": "^(?:)? \\S", "prompt": "╰─ " },
		"upper": "^(?:─{4,}|-{4,})$",
		"lower": "^(?:─{4,}|-{4,})$",
		"most_rows": 16,
		"most_share": 0.5,
		"scrolled": { "position": "unmarked", "min_rows": 4, "reserved_rows": 14, "min_reserved_rows": 6 },
		"menus": [
			{ "selected": "^ ?[❯→] \\S", "next": "^ {2,4}\\S", "hint": { "pattern": "[Ee]sc(?:ape)?\\b", "within": 20 } },
			{
				"selected": "^╭─ Models ─+┬─+╮$",
				"hint": { "pattern": "^│ ⏎/→ models · ↑/↓ providers · type to search · ⌥←/⌥→ kind · ⎋ close +│$", "within": 28 }
			},
			{ "selected": "^ *(?:↑/↓ select · ⏎ confirm · ⎋ skip · (?:⌃C|Ctrl\\+C)|Up/Down select · Enter confirm · Esc skip · Ctrl\\+C|↑/↓ select · \\x{F0311} confirm · \\x{F12B7} skip · (?:\\x{F0634} C|Ctrl\\+C)) exit setup *$" }
		]
	},
	"paste": {
		"bracketed": true,
		"enter_ms": 80,
		"placeholders": [
			{ "pattern": "^\\[Paste #\\d+, \\+(\\d+) lines\\]$", "count": "lines", "spaced": true },
			{ "pattern": "^\\[Paste #\\d+, (\\d+) chars\\]$", "count": "chars", "spaced": true }
		]
	},
	"session": { "capture": "session_start", "resume": ["--session", "${session_id}"] },
	"mcp": { "session_env_key": "PI_SESSION_ID" },
	"yolo": {
		"off_args": ["--approval-mode", "always-ask"],
		"work": { "args": ["--approval-mode", "yolo"] }
	}
}
