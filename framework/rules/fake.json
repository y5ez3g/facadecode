{
	"cli": "fake",
	"display_name": "Fake CLI",
	"program": "facade-fakecli",
	"arguments": {"reserved": ["--resume", "--model", "--effort", "--mcp-config"], "required": ["--model", "--effort", "--mcp-config"]},
	"choices": {"model": ["--model", "${value}"], "effort": ["--effort", "${value}"], "spelling": {"model": ["--model"], "effort": ["--effort"]}},
	"input": { "mechanism": "prompt_row", "prompt": "❯" },
	"paste": { "bracketed": true, "enter_ms": 80, "retry_submit_ms": 600, "placeholders": [{ "pattern": "^\\[Pastedtext#\\d+\\+(\\d+)lines?\\]$", "count": "lines_after_first" }] },
	"session": { "capture": "session_start", "resume": ["--resume", "${session_id}"] }
}
