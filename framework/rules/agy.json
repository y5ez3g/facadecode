{
	"cli": "agy",
	"display_name": "Antigravity",
	"program": "agy",
	"launch": { "agent_env": { "AGY_CLI_DISABLE_AUTO_UPDATE": "true" } },
	"arguments": {"reserved": ["--dangerously-skip-permissions", "--mode", "--sandbox", "--conversation", "--continue", "-c", "--remote-agent", "--print", "-p", "--prompt", "--prompt-interactive", "-i", "--model", "--effort"], "single_dash": true, "required": ["--add-dir", "--agent", "--conversation", "--effort", "--input-format", "--json-schema", "--log-file", "--mode", "--model", "--output-format", "--print-timeout", "--project", "--settings"]},
	"choices": {"model": ["--model", "${value}"], "effort": ["--effort", "${value}"], "spelling": {"model": ["--model"], "effort": ["--effort"]}},
	"input": {
		"mechanism": "frame",
		"prompt": ">",
		"gap": " ",
		"upper": "^─+$",
		"lower": "^─+$",
		"scrolled": { "position": "rows", "above": "^↑ (\\d+) more lines?$", "below": "^↓ (\\d+) more lines?$" },
		"placeholder": {
			"texts": [
				"Accept-edits mode: file edits auto-approved (shift+tab to cycle)",
				"Plan mode: research & plan only (shift+tab to cycle)",
				"Auto mode: edits & safe commands auto-approved (shift+tab to cycle)"
			],
			"footer": "^\\? for shortcuts(?:\\s|$)"
		},
		"menus": [{ "selected": "^ ?> \\S", "not_selected": "^ ?> /", "next": "^ {2,3}\\S", "hint": { "pattern": "^ {2,3}↑/↓ Navigate · ", "within": 8 } }]
	},
	"paste": {
		"bracketed": true,
		"backspace_unit": "grapheme",
		"enter_ms": 80,
		"line_ms": 45,
		"submit_clear_ms": 352,
		"placeholders": [
			{ "pattern": "^\\[Pastedtext#\\d+\\+(\\d+)lines?\\]$", "count": "lines" },
			{ "pattern": "^\\[Pasted text #\\d+ (\\d+) chars\\]$", "count": "unicode_scalars", "spaced": true }
		]
	},
	"session": { "capture": "session_start", "resume": ["--conversation", "${session_id}"] },
	"mcp": { "session_meta_key": "antigravity.google/root_conversation_id", "managed_instructions_from_hook": true },
	"ready_tools": { "text": "/mcp", "typed": "^> /mcp\\s*$", "ready": "✓\\s+facade_facade\\b", "opened": "^MCP Servers\\s*$|\\besc Exit\\b", "close": "Escape" },
	"yolo": {
		"work": { "args": ["--mode", "accept-edits", "--dangerously-skip-permissions"], "settings": { "enableTerminalSandbox": false } },
		"startup": { "settings": { "trustedWorkspaces": ["${folder}"] } }
	}
}
