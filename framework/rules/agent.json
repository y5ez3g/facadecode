{
	"cli": "agent",
	"display_name": "Cursor",
	"program": "agent",
	"arguments": {
		"reserved": ["--resume", "--continue", "--new-session-id", "--print", "-p", "--output-format", "--force", "-f", "--yolo", "--auto-review", "--approve-mcps", "--sandbox", "--trust", "--workspace", "--worktree", "-w", "--data-dir", "--exclude-workspace-context", "--model"],
		"required": ["--model", "--mode", "--add-dir", "--plugin-dir", "--image", "--api-key"],
		"clusters": ["-H", "-e"]
	},
	"choices": { "model": ["--model", "${value}"], "spelling": { "model": ["--model"] } },
	"input": {
		"mechanism": "prompt_row",
		"prompt": "→ ",
		"alternate_prompt": "> ",
		"placeholder": "^(?:Plan, search, build anything|Add a follow-up(?: — /plan to review and build)?)$",
		"dim_draft": "^\\[Pasted text #\\d+ \\+\\d+ lines?\\]$",
		"drawn_cursor": true,
		"menus": [
			{
				"selected": "^ *│ +▶ \\[(?:a\\] (?:Trust this workspace|Approve all servers)|w\\] Trust this workspace, but don't enable all MCP servers|c\\] Continue without approval|q\\] Quit) *│ *$",
				"hint": {
					"pattern": "^ *│ +Use arrow keys to navigate, Enter to select, or press the key shown *│ *$",
					"within": 4
				}
			},
			{
				"selected": "^ Run this MCP tool\\? *$",
				"next": "^ {2}→ Run \\(once\\) \\(y\\) *$",
				"hint": {
					"pattern": "^ {4}Allowlist MCP Tool \\(tab\\) *$",
					"within": 2
				}
			},
			{
				"selected": "^ +Cursor Agent$",
				"hint": { "pattern": "^ +Press any key to log in\\.\\.\\.$", "within": 2 }
			},
			{
				"selected": "^ Available models +Max mode:",
				"below_prompt": true,
				"hint": { "pattern": "^ Type to filter • Enter to select • Tab to edit$", "within": 9 }
			}
		]
	},
	"paste": {
		"bracketed": true,
		"enter_ms": 250,
		"placeholders": [
			{ "pattern": "^\\[Pasted text #\\d+ \\+(\\d+) lines?\\]$", "count": "lines", "spaced": true }
		]
	},
	"session": { "capture": "session_start", "resume": ["--resume", "${session_id}"], "resume_requires_saved_session": true },
	"status": {
		"mechanism": "composer",
		"working_hint": "ctrl+c to stop",
		"authentication": ["^ *Not logged in\\. Run /login first\\.$", "^ +Press any key to log in\\.\\.\\.$"],
		"permission": ["^ *(?:⚠ )?Workspace Trust Required$", "^ Run this MCP tool\\?$"]
	},
	"yolo": {
		"work": { "args": ["--force", "--sandbox", "disabled"] },
		"startup": { "args": ["--trust"] }
	}
}
