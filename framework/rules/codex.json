{
	"cli": "codex",
	"display_name": "Codex",
	"program": "codex",
	"launch": { "args": ["--no-daemon"] },
	"arguments": {"reserved": ["--dangerously-bypass-approvals-and-sandbox", "--yolo", "--sandbox", "-s", "--ask-for-approval", "-a", "--approve-for-me", "--not-so-yolo", "--cd", "-C", "--worktree", "--remote", "--remote-auth-token-env", "--no-daemon", "--model", "-m", "--last"], "attached": ["-s", "-a", "-C", "-m"], "variadic": ["--image", "-i"], "clusters": ["-C", "-a", "-c", "-i", "-m", "-p", "-s"], "config": {"options": ["-c", "--config"], "reserved": ["projects", "mcp_servers.facade", "mcp_optional_startup_grace_ms", "approval_policy", "sandbox_mode", "model", "model_reasoning_effort"]}},
	"choices": {"model": ["--model", "${value}"], "effort": ["-c", "model_reasoning_effort=${value_toml}"], "spelling": {"model": ["--model", "-m"], "config": {"model": "model", "effort": "model_reasoning_effort"}}},
	"input": {
		"mechanism": "prompt",
		"prompt": "›",
		"alternate_prompt": "»",
		"model_line": "^ {2}\\S.*? · (?:[~/]|[A-Za-z]:\\\\|…\\s*$)",
		"wrapped_footer_hint": "^(?: {2}(?:(?:← for agents · )?\\? for shortcuts(?: {2,}\\S.*)?|tab to queue message)| {20,}⚠ (?:1 warning|(?:[2-9]|[1-9][0-9]+) warnings) · f2 to view)$",
		"scrolled": { "position": "last_column", "above": "↑", "below": "↓" },
		"menus": [
			{ "selected": "^› \\d+\\. \\S", "next": "^ {2}\\d+\\. \\S", "hint": { "pattern": "^ {2}(?:Press )?[Ee]nter\\b", "within": 10 } },
			{
				"selected": { "prefix": "^ {2}", "text": "Giving this request a little extra thought", "indent": 2, "stop_at_dim": true },
				"hint": {
					"pattern": { "prefix": "^(?:› | {2})[12]\\. ", "text": "Dismiss and keep waiting", "indent": 5 },
					"within": 30
				}
			}
		]
	},
	"paste": {
		"bracketed": true,
		"backspace_unit": "legacy_grapheme",
		"backspace_single_code_points": "^[\\u{0E31}\\u{0E34}-\\u{0E3A}\\u{0E47}-\\u{0E4E}]$",
		"enter_ms": 80,
		"submit_clear_ms": 132,
		"tab_while_working": true,
		"placeholders": [
			{ "pattern": "^\\[PastedContent(\\d+)chars?\\]$", "count": "chars" },
			{ "pattern": "^\\[PastedContent(\\d+)chars?\\]$", "count": "chars", "after_first_character": true }
		]
	},
	"session": { "capture": "session_start", "resume": ["resume", "${session_id}"] },
	"mcp": { "session_meta_key": "sessionId" },
	"status": {
		"mechanism": "background_correction",
		"hints": "^(?: {2}(?:← for agents · )?\\? for shortcuts(?: {2,}\\S.*)?| {20,}\\S.*)$",
		"background": "^ {2}([1-9]\\d*) background terminals? running",
		"footer": "  ${count} background terminal${s} running · /ps to view · /stop to close",
		"worked": "^ {2}Worked for (?:<1s|(?:\\d+[hms] ?)+) • \\d{1,2}:\\d{2}(?: [AP]M)?$"
	},
	"yolo": {
		"work": { "args": ["--dangerously-bypass-approvals-and-sandbox"] },
		"startup": {
			"args": [
				"-c", "projects={ ${folder_toml} = { trust_level = \"trusted\" } }",
				"-c", "check_for_update_on_startup=false",
				"-c", "notice.model_migrations={ \"gpt-5.6-sol\" = \"gpt-6-sol\", \"gpt-5.6-terra\" = \"gpt-6-sol\", \"gpt-5.6-luna\" = \"gpt-6-luna\", \"gpt-5.5\" = \"gpt-6-sol\" }"
			]
		}
	},
	"console": { "per_char_ms": 3, "records_above_bmp": true, "line_break": "shift_enter" }
}
