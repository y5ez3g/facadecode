		"configuration": [
			{
				"id": "facade.agents",
				"title": "%config.title%",
				"order": 2,
				"properties": {
					"facade.home": {
						"type": "string",
						"default": "~/.facade",
						"scope": "machine",
						"order": 0,
						"pattern": "^$|^(~[\\\\/]|/|[A-Za-z]:[\\\\/]|\\\\\\\\)",
						"patternErrorMessage": "%config.home.pattern%",
						"markdownDescription": "%config.home%"
					},
					"facade.yolo": {
						"type": "boolean",
						"default": true,
						"scope": "machine",
						"markdownDescription": "%config.yolo%",
