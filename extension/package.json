{
	"name": "facadecode",
	"displayName": "%displayName%",
	"description": "%description%",
	"version": "0.1.2",
	"private": true,
	"publisher": "facade",
	"repository": {
		"type": "git",
		"url": "https://github.com/y5ez3g/facadecode.git",
		"directory": "extension"
	},
	"bugs": {
		"url": "https://github.com/y5ez3g/facadecode/issues"
	},
	"homepage": "https://facadecode.com",
	"engines": {
		"vscode": "^1.105.0"
	},
	"categories": [
		"AI"
	],
	"capabilities": {
		"virtualWorkspaces": false,
		"untrustedWorkspaces": {
			"supported": false
		}
	},
	"extensionKind": [
		"workspace"
	],
	"extensionPack": [
		"facade.facadecode-window"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./dist/extension.js",
	"scripts": {
		"postinstall": "node scripts/postinstall.mjs",
		"compile": "node -e \"require('fs').rmSync('build/out',{recursive:true,force:true})\" && tsc -p ./ && tsc -p ./src/webview",
		"watch": "node scripts/build.mjs --watch",
		"bundle": "node scripts/build.mjs",
		"test": "mocha --ui tdd --timeout 30000 --require build/out/test/setup.js \"build/out/test/**/*.test.js\"",
		"measure:mcp": "node scripts/measure-mcp.mjs",
		"package": "node scripts/package.mjs",
		"test:package": "node --test scripts/package.test.mjs",
		"test:integration": "node scripts/build-it.mjs && node ./build/out/test/integration/run.js",
		"test:remote": "node scripts/build-it.mjs && node ./build/out/test/integration/remote.js"
	},
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "facade",
					"title": "%view.container%",
					"icon": "media/facade.svg"
				}
			]
		},
		"views": {
			"facade": [
				{
					"type": "webview",
					"id": "facade.agents",
					"name": "%view.container%"
				}
			]
		},
		"commands": [
			{
				"command": "facade.newAgent",
				"title": "%command.newAgent%",
				"category": "%command.category%",
				"icon": "$(facade-new-agent)"
			},
			{
				"command": "facade.history",
				"title": "%command.history%",
				"category": "%command.category%",
				"icon": "$(history)"
			},
			{
				"command": "facade.pinAgent",
				"title": "%command.pinAgent%",
				"category": "%command.category%"
			},
			{
				"command": "facade.unpinAgent",
				"title": "%command.unpinAgent%",
				"category": "%command.category%"
			},
			{
				"command": "facade.showActiveAgents",
				"title": "%command.showActiveAgents%",
				"category": "%command.category%"
			},
			{
				"command": "facade.renameAgent",
				"title": "%command.renameAgent%",
				"category": "%command.category%"
			},
			{
				"command": "facade.closeAgent",
				"title": "%command.closeAgent%",
				"category": "%command.category%"
			},
			{
				"command": "facade.showAgentDetails",
				"title": "%command.showAgentDetails%",
				"category": "%command.category%"
			},
			{
				"command": "facade.filter",
				"title": "%command.filter%",
				"category": "%command.category%",
				"icon": "$(filter)"
			},
			{
				"command": "facade.openSettings",
				"title": "%command.openSettings%",
				"category": "%command.category%"
			},
			{
				"command": "facade.showAgentLaunch",
				"title": "%command.showAgentLaunch%",
				"category": "%command.category%"
			},
			{
				"command": "facade.showAgentsLog",
				"title": "%command.showAgentsLog%",
				"category": "%command.category%"
			},
			{
				"command": "facade.newWorktree",
				"title": "%command.newWorktree%",
				"category": "%command.category%"
			},
			{
				"command": "facade.moveUp",
				"title": "%command.moveUp%",
				"category": "%command.category%"
			},
			{
				"command": "facade.moveDown",
				"title": "%command.moveDown%",
				"category": "%command.category%"
			},
			{
				"command": "facade.filterOn",
				"title": "%command.filter%",
				"category": "%command.category%",
				"icon": "$(filter-filled)"
			},
			{
				"command": "facade.revealAgent",
				"title": "%command.revealAgent%",
				"category": "%command.category%"
			},
			{
				"command": "facade.openSettingsFile",
				"title": "%command.openSettingsFile%",
				"category": "%command.category%"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "facade.filter",
					"when": "view == facade.agents && !facade.filtered && !facade.onePlace",
					"group": "navigation@1"
				},
				{
					"command": "facade.filterOn",
					"when": "view == facade.agents && facade.filtered",
					"group": "navigation@1"
				},
				{
					"command": "facade.history",
					"when": "view == facade.agents",
					"group": "navigation@2"
				},
				{
					"command": "facade.newAgent",
					"when": "view == facade.agents",
					"group": "navigation@3"
				},
				{
					"command": "workbench.action.addRootFolder",
					"when": "view == facade.agents",
					"group": "1_locations@1"
				},
				{
					"command": "facade.newWorktree",
					"when": "view == facade.agents && workspaceFolderCount != 0",
					"group": "1_locations@2"
				},
				{
					"command": "facade.openSettings",
					"when": "view == facade.agents",
					"group": "9_configure@1"
				}
			],
			"webview/context": [
				{
					"command": "facade.renameAgent",
					"when": "webviewId == 'facade.agents' && webviewSection == 'agent'",
					"group": "1_agent@1"
				},
				{
					"command": "facade.moveUp",
					"when": "webviewId == 'facade.agents' && webviewSection == 'agent' && webviewMoveUp",
					"group": "2_move@1"
				},
				{
					"command": "facade.moveDown",
					"when": "webviewId == 'facade.agents' && webviewSection == 'agent' && webviewMoveDown",
					"group": "2_move@2"
				},
				{
					"command": "facade.closeAgent",
					"when": "webviewId == 'facade.agents' && webviewSection == 'agent'",
					"group": "4_close@1"
				}
			],
			"commandPalette": [
				{
					"command": "facade.renameAgent",
					"when": "facade.agentSelected"
				},
				{
					"command": "facade.closeAgent",
					"when": "facade.agentSelected"
				},
				{
					"command": "facade.showAgentDetails",
					"when": "facade.agentSelected && facade.agentSelectedVisible"
				},
				{
					"command": "facade.newWorktree",
					"when": "false"
				},
				{
					"command": "facade.moveUp",
					"when": "false"
				},
				{
					"command": "facade.moveDown",
					"when": "false"
				},
				{
					"command": "facade.filterOn",
					"when": "false"
				},
				{
					"command": "facade.revealAgent",
					"when": "false"
				},
				{
					"command": "facade.openSettingsFile",
					"when": "false"
				},
				{
					"command": "facade.pinAgent",
					"when": "facade.agentSelected && facade.agentSelectedPinnable && !facade.agentSelectedPinned"
				},
				{
					"command": "facade.unpinAgent",
					"when": "facade.agentSelectedPinned"
				},
				{
					"command": "facade.filter",
					"when": "!facade.onePlace || facade.filtered"
				}
			]
		},
