				}
			}
		},
		"configuration": [
			{
				"id": "facade.agents",
				"title": "%config.title%",
				"order": 2,
				"properties": {
					"facade.home": {
						"type": "string",
						"default": "~/.facade",
						"scope": "machine",
						"order": 0,
						"pattern": "^$|^(~[\\\\/]|/|[A-Za-z]:[\\\\/]|\\\\\\\\)",
						"patternErrorMessage": "%config.home.pattern%",
						"markdownDescription": "%config.home%"
					},
					"facade.framework": {
						"type": "string",
						"enum": [
							"auto",
							"off"
						],
						"default": "auto",
						"scope": "machine",
						"order": 1,
						"markdownDescription": "%config.framework%"
					}
				}
			}
		],
		"jsonValidation": [
			{
				"fileMatch": [
					"**/facade.json"
				],
				"url": "./media/settings.schema.json"
			}
		]
	},
	"dependencies": {
		"@xterm/addon-serialize": "^0.14.0",
		"@xterm/addon-unicode11": "^0.9.0",
		"@xterm/headless": "^6.0.0",
		"jsonc-parser": "3.3.1",
		"node-pty": "1.2.0-beta.15",
		"smol-toml": "1.9.1"
	},
	"devDependencies": {
		"@types/mocha": "^10.0.10",
		"@types/node": "^22.20.5",
		"@types/vscode": "1.105.0",
		"@vscode/test-electron": "^3.1.0",
		"@vscode/vsce": "4.1.0",
		"esbuild": "^0.28.2",
		"js-yaml": "4.3.2",
		"mocha": "^11.8.0",
		"typescript": "^5.9.3"
	},
	"l10n": "./l10n",
	"license": "MIT",
	"icon": "media/icon.png",
	"keywords": [
		"agents",
		"claude code",
		"codex",
		"antigravity",
		"muse code",
		"opencode",
		"pi",
		"claude",
		"muse",
		"ai agents",
		"coding agent",
		"multi-agent",
		"agent orchestration",
		"orchestrator",
		"mcp",
		"model context protocol",
		"git worktree",
		"worktree",
		"remote ssh",
		"ssh",
		"terminal",
		"agent mesh",
		"agent panel",
		"remote control",
		"subagents",
		"autonomous agents",
		"ai pair programming",
		"cli"
	],
	"galleryBanner": {
		"color": "#f5f3ed",
		"theme": "light"
	}
}
