{
	"name": "facadecode",
	"displayName": "%displayName%",
	"description": "%description%",
	"version": "0.1.6",
	"private": true,
	"publisher": "facade",
	"repository": {
		"type": "git",
		"url": "https://github.com/y5ez3g/facadecode.git",
		"directory": "extension"
	},
	"bugs": {
		"url": "https://github.com/y5ez3g/facadecode/issues"
	},
	"homepage": "https://facadecode.com",
	"engines": {
		"vscode": "^1.105.0"
	},
	"categories": [
		"AI"
	],
	"capabilities": {
		"virtualWorkspaces": false,
		"untrustedWorkspaces": {
			"supported": false
		}
	},
	"extensionKind": [
		"workspace"
	],
	"extensionPack": [
		"facade.facadecode-window"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./dist/extension.js",
	"scripts": {
		"postinstall": "node scripts/postinstall.mjs",
		"compile": "node -e \"require('fs').rmSync('build/out',{recursive:true,force:true})\" && tsc -p ./ && tsc -p ./src/webview",
		"watch": "node scripts/build.mjs --watch",
		"bundle": "node scripts/build.mjs",
		"test": "mocha --ui tdd --timeout 30000 --require build/out/test/setup.js \"build/out/test/**/*.test.js\"",
		"measure:mcp": "node scripts/measure-mcp.mjs",
		"package": "node scripts/package.mjs",
		"test:package": "node --test scripts/package.test.mjs",
		"test:integration": "node scripts/build-it.mjs && node ./build/out/test/integration/run.js",
		"test:remote": "node scripts/build-it.mjs && node ./build/out/test/integration/remote.js"
	},
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "facade",
					"title": "%view.container%",
					"icon": "media/facade.svg"
				}
			]
		},
		"views": {
			"facade": [
				{
					"type": "webview",
					"id": "facade.agents",
					"name": "%view.container%"
				}
			]
		},
		"commands": [
			{
				"command": "facade.newAgent",
				"title": "%command.newAgent%",
				"category": "%command.category%",
				"icon": "$(facade-new-agent)"
			},
			{
				"command": "facade.resumeAgent",
				"title": "%command.resumeAgent%",
				"category": "%command.category%",
				"icon": "$(history)"
			},
			{
				"command": "facade.continueSession",
				"title": "%command.continueSession%",
				"category": "%command.category%",
				"icon": "$(history)"
			},
			{
				"command": "facade.pinAgent",
				"title": "%command.pinAgent%",
				"category": "%command.category%"
			},
			{
				"command": "facade.unpinAgent",
				"title": "%command.unpinAgent%",
				"category": "%command.category%"
			},
			{
				"command": "facade.goToAgent",
				"title": "%command.goToAgent%",
				"category": "%command.category%",
				"icon": "$(go-to-file)"
			},
			{
				"command": "facade.openTerminal",
				"title": "%command.openTerminal%",
				"category": "%command.category%"
			},
			{
				"command": "facade.hideAgent",
				"title": "%command.hideAgent%",
				"category": "%command.category%"
			},
			{
				"command": "facade.renameAgent",
				"title": "%command.renameAgent%",
				"category": "%command.category%"
			},
			{
				"command": "facade.stopAgent",
				"title": "%command.stopAgent%",
				"category": "%command.category%"
			},
			{
				"command": "facade.deleteAgent",
				"title": "%command.deleteAgent%",
				"category": "%command.category%"
			},
			{
				"command": "facade.copyAgentReference",
				"title": "%command.copyAgentReference%",
				"category": "%command.category%"
			},
			{
				"command": "facade.dismissAgent",
				"title": "%command.dismissAgent%",
				"category": "%command.category%"
			},
			{
				"command": "facade.showAgentDetails",
				"title": "%command.showAgentDetails%",
				"category": "%command.category%"
			},
			{
				"command": "facade.filter",
				"title": "%command.filter%",
				"category": "%command.category%",
				"icon": "$(filter)"
			},
			{
				"command": "facade.openSettings",
				"title": "%command.openSettings%",
				"category": "%command.category%"
			},
			{
				"command": "facade.showAgentLaunch",
				"title": "%command.showAgentLaunch%",
				"category": "%command.category%"
			},
			{
				"command": "facade.showAgentsLog",
				"title": "%command.showAgentsLog%",
				"category": "%command.category%"
			},
			{
				"command": "facade.newWorktree",
				"title": "%command.newWorktree%",
				"category": "%command.category%"
			},
			{
				"command": "facade.moveUp",
				"title": "%command.moveUp%",
				"category": "%command.category%"
			},
			{
				"command": "facade.moveDown",
				"title": "%command.moveDown%",
				"category": "%command.category%"
			},
			{
				"command": "facade.filterOn",
				"title": "%command.filter%",
				"category": "%command.category%",
				"icon": "$(filter-filled)"
			},
			{
				"command": "facade.revealAgent",
				"title": "%command.revealAgent%",
				"category": "%command.category%"
			},
			{
				"command": "facade.openSettingsFile",
				"title": "%command.openSettingsFile%",
				"category": "%command.category%"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "facade.filter",
					"when": "view == facade.agents && !facade.filtered && !facade.onePlace",
					"group": "navigation@1"
				},
				{
					"command": "facade.filterOn",
					"when": "view == facade.agents && facade.filtered",
					"group": "navigation@1"
				},
				{
					"command": "facade.resumeAgent",
					"when": "view == facade.agents && facade.implementation == framework",
					"group": "navigation@2"
				},
				{
					"command": "facade.continueSession",
					"when": "view == facade.agents && facade.implementation != framework",
					"group": "navigation@2"
				},
				{
					"command": "facade.goToAgent",
					"when": "view == facade.agents && facade.implementation == framework",
					"group": "navigation@3"
				},
				{
					"command": "facade.newAgent",
					"when": "view == facade.agents",
					"group": "navigation@4"
				},
				{
					"command": "workbench.action.addRootFolder",
					"when": "view == facade.agents",
					"group": "1_locations@1"
				},
				{
					"command": "facade.newWorktree",
					"when": "view == facade.agents && workspaceFolderCount != 0 && facade.implementation != framework",
					"group": "1_locations@2"
				},
				{
					"command": "facade.openSettings",
					"when": "view == facade.agents",
					"group": "9_configure@1"
				}
			],
			"webview/context": [
				{
					"command": "facade.renameAgent",
					"when": "webviewId == 'facade.agents' && webviewSection == 'agent' && facade.implementation != framework",
					"group": "1_agent@1"
				},
				{
					"command": "facade.moveUp",
					"when": "webviewId == 'facade.agents' && webviewSection == 'agent' && webviewMoveUp && facade.implementation != framework",
					"group": "2_move@1"
				},
				{
					"command": "facade.moveDown",
					"when": "webviewId == 'facade.agents' && webviewSection == 'agent' && webviewMoveDown && facade.implementation != framework",
					"group": "2_move@2"
				},
				{
					"command": "facade.stopAgent",
					"when": "webviewId == 'facade.agents' && webviewSection == 'agent' && !webviewAgentEnded && facade.implementation != framework",
					"group": "4_close@1"
				},
				{
					"command": "facade.dismissAgent",
					"when": "webviewId == 'facade.agents' && webviewSection == 'agent' && webviewAgentEnded && facade.implementation != framework",
					"group": "4_close@1"
				},
				{
					"command": "facade.openTerminal",
					"when": "webviewId == 'facade.agents' && webviewSection == 'agent' && facade.implementation == framework && webviewAgentRunning",
					"group": "1_agent@1"
				},
				{
					"command": "facade.hideAgent",
					"when": "webviewId == 'facade.agents' && webviewSection == 'agent' && facade.implementation == framework",
					"group": "1_agent@2"
				},
				{
					"command": "facade.stopAgent",
					"when": "webviewId == 'facade.agents' && webviewSection == 'agent' && facade.implementation == framework && webviewAgentRunning",
					"group": "1_agent@3"
				},
				{
					"command": "facade.deleteAgent",
					"when": "webviewId == 'facade.agents' && webviewSection == 'agent' && facade.implementation == framework",
					"group": "1_agent@4"
				},
				{
					"command": "facade.pinAgent",
					"when": "webviewId == 'facade.agents' && webviewSection == 'agent' && facade.implementation == framework && webviewAgentPinnable && !webviewAgentPinned",
					"group": "1_agent@5"
				},
				{
					"command": "facade.unpinAgent",
					"when": "webviewId == 'facade.agents' && webviewSection == 'agent' && facade.implementation == framework && webviewAgentPinned",
					"group": "1_agent@6"
				},
				{
					"command": "facade.renameAgent",
					"when": "webviewId == 'facade.agents' && webviewSection == 'agent' && facade.implementation == framework",
					"group": "1_agent@7"
				}
			],
			"commandPalette": [
				{
					"command": "facade.resumeAgent",
					"when": "facade.implementation == framework"
				},
				{
					"command": "facade.continueSession",
					"when": "facade.implementation != framework"
				},
				{
					"command": "facade.showAgentLaunch",
					"when": "facade.implementation != framework"
				},
				{
					"command": "facade.renameAgent",
					"when": "facade.agentSelected"
				},
				{
					"command": "facade.openTerminal",
					"when": "facade.implementation == framework && facade.agentSelected && facade.agentSelectedRunning"
				},
				{
					"command": "facade.hideAgent",
					"when": "facade.implementation == framework && facade.agentSelected"
				},
				{
					"command": "facade.stopAgent",
					"when": "facade.agentSelected && ((facade.implementation == framework && facade.agentSelectedRunning) || (facade.implementation != framework && !facade.agentSelectedEnded))"
				},
				{
					"command": "facade.deleteAgent",
					"when": "facade.implementation == framework && facade.agentSelected"
				},
				{
					"command": "facade.copyAgentReference",
					"when": "facade.implementation == framework && facade.agentSelected"
				},
				{
					"command": "facade.dismissAgent",
					"when": "facade.agentSelected && facade.agentSelectedEnded && facade.implementation != framework"
				},
				{
					"command": "facade.showAgentDetails",
					"when": "facade.agentSelected && facade.agentSelectedVisible"
				},
				{
					"command": "facade.newWorktree",
					"when": "false"
				},
				{
					"command": "facade.moveUp",
					"when": "false"
				},
				{
					"command": "facade.moveDown",
					"when": "false"
				},
				{
					"command": "facade.filterOn",
					"when": "false"
				},
				{
					"command": "facade.revealAgent",
					"when": "false"
				},
				{
					"command": "facade.openSettingsFile",
					"when": "false"
				},
				{
					"command": "facade.pinAgent",
					"when": "facade.agentSelected && facade.agentSelectedPinnable && !facade.agentSelectedPinned"
				},
				{
					"command": "facade.unpinAgent",
					"when": "facade.agentSelectedPinned"
				},
				{
					"command": "facade.filter",
					"when": "!facade.onePlace || facade.filtered"
				}
			]
		},
		"icons": {
			"facade-new-agent": {
				"description": "%icon.newAgent%",
				"default": {
					"fontPath": "./media/new-agent.woff",
					"fontCharacter": "\\EC84"
				}
			},
			"facade-cli-claude": {
				"description": "%config.claude.title%",
				"default": {
					"fontPath": "./media/agent-icons.woff",
					"fontCharacter": "\\E001"
				}
			},
			"facade-cli-codex": {
				"description": "%config.codex.title%",
				"default": {
					"fontPath": "./media/agent-icons.woff",
					"fontCharacter": "\\E002"
				}
			},
			"facade-cli-agy": {
				"description": "%config.antigravity.title%",
				"default": {
					"fontPath": "./media/agent-icons.woff",
					"fontCharacter": "\\E003"
				}
			},
			"facade-cli-muse": {
				"description": "%config.muse.title%",
				"default": {
					"fontPath": "./media/agent-icons.woff",
					"fontCharacter": "\\E004"
				}
			},
			"facade-cli-opencode": {
				"description": "%config.opencode.title%",
				"default": {
					"fontPath": "./media/agent-icons.woff",
					"fontCharacter": "\\E005"
				}
			},
			"facade-cli-pi": {
				"description": "%config.pi.title%",
				"default": {
					"fontPath": "./media/agent-icons.woff",
					"fontCharacter": "\\E006"
				}
			},
			"facade-robot-red": {
				"description": "%icon.robot%",
				"default": {
					"fontPath": "./media/robots.woff",
					"fontCharacter": "\\E200"
				}
			},
			"facade-robot-orange": {
				"description": "%icon.robot%",
				"default": {
					"fontPath": "./media/robots.woff",
					"fontCharacter": "\\E201"
				}
			},
			"facade-robot-amber": {
				"description": "%icon.robot%",
				"default": {
					"fontPath": "./media/robots.woff",
					"fontCharacter": "\\E202"
				}
			},
			"facade-robot-lime": {
