{
	"compilerOptions": {
		"esModuleInterop": true,
		"target": "ES2024",
		"lib": [
			"ES2024"
		],
		"module": "commonjs",
		"rootDir": "./src",
		"outDir": "./build/out",
		"strict": true,
		"exactOptionalPropertyTypes": false,
		"useUnknownInCatchVariables": false,
		"noImplicitReturns": true,
		"noImplicitOverride": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"forceConsistentCasingInFileNames": true,
		"types": [
			"node",
			"mocha"
		],
		"skipLibCheck": true,
		"sourceMap": true
	},
	"include": [
		"src/**/*"
	],
	"exclude": [
		"src/webview"
	]
}
